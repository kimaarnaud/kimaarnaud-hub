---
import Base from '../layouts/Base.astro';
---

<Base title="Contact">
  <h1 class="text-3xl font-bold tracking-tight">Contact</h1>
  <p class="mt-2 text-slate-600 max-w-3xl">
    Pour échanger sur un projet, une collaboration ou une opportunité.
  </p>
  <ul class="mt-6 space-y-2">
    <li>
      E-mail :{' '}
      <a href="mailto:contact@kimaarnaud.com" class="underline underline-offset-4">
        contact@kimaarnaud.com
      </a>
    </li>
    <li>
      GitHub :{' '}
      <a href="https://github.com/kimaarnaud" class="underline underline-offset-4">
        github.com/kimaarnaud
      </a>
    </li>
    <li>
      LinkedIn :{' '}
      <a href="https://www.linkedin.com/in/kimaarnaud" class="underline underline-offset-4">
        linkedin.com/in/kimaarnaud
      </a>
    </li>
  </ul>
</Base>
