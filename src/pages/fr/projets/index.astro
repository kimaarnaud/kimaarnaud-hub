---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { DOMAINS, type Domain } from '../../../content.config';

const projets = (await getCollection('projets')).sort((a, b) =>
  a.data.domain === b.data.domain
    ? a.data.number - b.data.number
    : Object.keys(DOMAINS).indexOf(a.data.domain) - Object.keys(DOMAINS).indexOf(b.data.domain),
);

const field =
  'w-full rounded-md border border-line bg-surface px-3 py-2 text-sm text-ink transition-colors duration-200 placeholder:text-ink-3 hover:border-ink-3/50';
---

<Base
  title="Projets"
  description="Les 80 projets du portfolio, filtrables par domaine, niveau, statut et technologie."
>
  <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent-ink">Index</p>
  <h1 class="mt-3 text-4xl font-bold tracking-tight">Projets</h1>
  <p class="mt-3 max-w-[62ch] text-ink-2">
    {projets.length} fiches, triées et filtrables par domaine, niveau, statut ou mot-clé.
    Chaque fiche mène aux preuves : rapports, mesures, code, démos.
  </p>

  <form id="filters" class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-5" aria-label="Filtres">
    <select name="domain" class={field} aria-label="Domaine">
      <option value="">Tous les domaines</option>
      {(Object.keys(DOMAINS) as Domain[]).map((d) => (
        <option value={d}>{DOMAINS[d].label}</option>
      ))}
    </select>
    <select name="level" class={field} aria-label="Niveau">
      <option value="">Tous les niveaux</option>
      <option value="fondations">Fondations</option>
      <option value="avance">Avancé</option>
      <option value="expert">Expert</option>
    </select>
    <select name="status" class={field} aria-label="Statut">
      <option value="">Tous les statuts</option>
      <option value="termine">Terminé</option>
      <option value="en-cours">En cours</option>
      <option value="planifie">Planifié</option>
    </select>
    <select name="sort" class={field} aria-label="Tri">
      <option value="numero">Tri : numéro</option>
      <option value="statut">Tri : statut</option>
      <option value="updated">Tri : mise à jour</option>
      <option value="titre">Tri : titre A→Z</option>
    </select>
    <input
      name="q"
      type="search"
      placeholder="Technologie, compétence…"
      class={field}
      aria-label="Recherche"
    />
  </form>

  <div class="mt-5 flex items-center justify-between gap-4">
    <p id="count" class="font-mono text-xs text-ink-3" aria-live="polite"></p>
    <button
      type="button"
      id="reset"
      class="hidden font-mono text-xs text-ink-3 underline-offset-4 transition-colors hover:text-ink hover:underline"
    >
      réinitialiser les filtres
    </button>
  </div>

  <div id="grid" class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {projets.map((p) => (
      <ProjectCard projet={p} />
    ))}
  </div>
  <p id="empty" class="mt-8 text-ink-2" hidden>
    Aucun projet ne correspond à ces filtres.
  </p>
</Base>

<script>
  const form = document.getElementById('filters') as HTMLFormElement;
  const grid = document.getElementById('grid')!;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>(':scope > article'));
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  const reset = document.getElementById('reset')!;

  const order = new Map(cards.map((c, i) => [c, i]));
  const statusRank: Record<string, number> = { termine: 0, 'en-cours': 1, planifie: 2 };
  const titleOf = (c: HTMLElement) =>
    c.querySelector('h3')?.textContent?.trim().toLowerCase() ?? '';

  const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
    numero: (a, b) => order.get(a)! - order.get(b)!,
    statut: (a, b) =>
      statusRank[a.dataset.status ?? 'planifie'] - statusRank[b.dataset.status ?? 'planifie'] ||
      order.get(a)! - order.get(b)!,
    updated: (a, b) =>
      Number(b.dataset.updated ?? 0) - Number(a.dataset.updated ?? 0) ||
      order.get(a)! - order.get(b)!,
    titre: (a, b) => titleOf(a).localeCompare(titleOf(b), 'fr'),
  };

  function apply() {
    const data = new FormData(form);
    const domain = data.get('domain') as string;
    const level = data.get('level') as string;
    const status = data.get('status') as string;
    const sort = (data.get('sort') as string) || 'numero';
    const q = ((data.get('q') as string) || '').trim().toLowerCase();

    const visible = cards.filter((card) => {
      const ok =
        (!domain || card.dataset.domain === domain) &&
        (!level || card.dataset.level === level) &&
        (!status || card.dataset.status === status) &&
        (!q || (card.dataset.search ?? '').includes(q));
      card.hidden = !ok;
      return ok;
    });

    visible.sort(sorters[sort] ?? sorters.numero).forEach((c) => grid.append(c));

    count.textContent = `${visible.length}/${cards.length} projets affichés`;
    empty.hidden = visible.length > 0;
    reset.classList.toggle('hidden', !domain && !level && !status && !q);

    const params = new URLSearchParams();
    for (const [k, v] of data) {
      if (v && !(k === 'sort' && v === 'numero')) params.set(k, v as string);
    }
    history.replaceState(null, '', params.size ? `?${params}` : location.pathname);
  }

  const initial = new URLSearchParams(location.search);
  for (const [k, v] of initial) {
    const field = form.elements.namedItem(k) as HTMLInputElement | HTMLSelectElement | null;
    if (field) field.value = v;
  }
  reset.addEventListener('click', () => {
    form.reset();
    apply();
  });
  form.addEventListener('input', apply);
  apply();
</script>
