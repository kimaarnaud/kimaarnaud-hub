---
import { getCollection, render, getEntries } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { DOMAINS } from '../../../content.config';

export async function getStaticPaths() {
  const articles = await getCollection('retex');
  return articles.map((a) => ({ params: { id: a.id }, props: { article: a } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const related = await getEntries(article.data.projets);
const fmt = (d: Date) =>
  d.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={article.data.title} description={article.data.summary} hasAlternate={false}>
  <nav aria-label="Fil d'Ariane" class="flex items-center gap-2 font-mono text-xs text-ink-3">
    <a href="/fr/blog/" class="transition-colors hover:text-ink">journal</a>
    <span aria-hidden="true">/</span>
    <span class="text-ink-2">{article.id}</span>
  </nav>

  <header class="mt-6 max-w-3xl border-b border-line pb-8">
    <p class="font-mono text-xs text-ink-3">
      <time datetime={article.data.date.toISOString()}>{fmt(article.data.date)}</time>
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{article.data.title}</h1>
    {article.data.tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Tags">
        {article.data.tags.map((t) => (
          <li class="rounded bg-surface-2 px-2 py-0.5 font-mono text-[11px] text-ink-2">{t}</li>
        ))}
      </ul>
    )}
  </header>

  <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_280px]">
    <article class="prose max-w-none prose-code:before:content-none prose-code:after:content-none">
      <Content />
    </article>

    {related.length > 0 && (
      <aside class="text-sm lg:border-l lg:border-line lg:pl-8">
        <h2 class="font-mono text-[11px] uppercase tracking-wider text-ink-3">Projets liés</h2>
        <ul class="mt-2.5 space-y-3">
          {related.map((p) => (
            <li style={`--dom: var(--${DOMAINS[p.data.domain].color})`}>
              <a
                href={`/projets/${p.id}/`}
                class="flex items-center gap-2 font-medium underline-offset-4 transition-colors hover:text-accent-ink hover:underline"
              >
                <span class="h-1.5 w-1.5 shrink-0 rounded-xs bg-(--dom)" aria-hidden="true" />
                {DOMAINS[p.data.domain].short} {String(p.data.number).padStart(2, '0')} — {p.data.title}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</Base>
