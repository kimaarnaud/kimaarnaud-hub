---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';

const articles = (await getCollection('retex')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base
  title="Journal"
  hasAlternate={false}
  description="Retours d'expérience sur les projets du portfolio : ce qui a marché, ce qui a échoué, ce que j'ai appris."
>
  <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent-ink">journal</p>
  <h1 class="mt-3 text-4xl font-bold tracking-tight">Retours d'expérience</h1>
  <p class="mt-3 max-w-[62ch] text-ink-2">
    Après chaque projet : ce qui a marché, ce qui a échoué, ce que j'en retiens.
    Également disponible en <a href="/rss.xml" class="text-accent-ink underline-offset-4 hover:underline">RSS</a>.
  </p>

  {articles.length > 0 ? (
    <div class="mt-10 border-t border-line">
      {articles.map((a) => (
        <a
          href={`/blog/${a.id}/`}
          class="group grid gap-1 border-b border-line py-5 transition-colors duration-200 hover:bg-surface sm:grid-cols-[9rem_1fr_auto] sm:items-baseline sm:gap-6 sm:px-3"
        >
          <span class="font-mono text-xs tabular-nums text-ink-3">{fmt(a.data.date)}</span>
          <span class="min-w-0">
            <span class="block font-medium tracking-tight underline-offset-4 group-hover:underline">
              {a.data.title}
            </span>
            <span class="mt-1 block text-sm leading-relaxed text-ink-2 line-clamp-2">
              {a.data.summary}
            </span>
          </span>
          <span class="hidden gap-1 sm:flex">
            {a.data.tags.slice(0, 3).map((t) => (
              <span class="rounded bg-surface-2 px-1.5 py-0.5 font-mono text-[10px] text-ink-3">{t}</span>
            ))}
          </span>
        </a>
      ))}
    </div>
  ) : (
    <p class="mt-10 text-ink-2">Aucun article pour l'instant.</p>
  )}
</Base>
