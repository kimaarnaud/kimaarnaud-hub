---
import Base from '../../layouts/Base.astro';

const catalogues = [
  {
    slug: '20-projets-logiciels',
    title: '20 projets de développement logiciel',
    desc: 'Applications web et mobile, stack justifiée, fonctionnalités, phases et documentation.',
    color: 'var(--dom-logiciel)',
  },
  {
    slug: '20-projets-reseaux-systemes-securite',
    title: '20 projets réseaux, systèmes et sécurité',
    desc: 'Du lab virtuel au SOC : notions, outils, étapes, preuves et plateforme LabHub.',
    color: 'var(--dom-reseaux)',
  },
  {
    slug: '20-projets-telecoms',
    title: '20 projets télécoms',
    desc: 'Signal, IP/MPLS, VoIP, FTTH, 4G/5G, LoRaWAN, satellite, NFV : mesures et TelcoLab Hub.',
    color: 'var(--dom-telecoms)',
  },
  {
    slug: '20-projets-ia',
    title: "20 projets d'intelligence artificielle",
    desc: 'Du ML écrit à la main au produit IA gouverné : expériences, évaluation, MLOps et AI Lab Hub.',
    color: 'var(--dom-ia)',
  },
];
---

<Base
  title="Catalogues"
  description="Les quatre catalogues de projets qui structurent ce portfolio, consultables en ligne ou en PDF."
>
  <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent-ink">Feuilles de route</p>
  <h1 class="mt-3 text-4xl font-bold tracking-tight">Catalogues de projets</h1>
  <p class="mt-3 max-w-[62ch] text-ink-2">
    Chaque catalogue décrit 20 projets progressifs : objectif, notions à apprendre, outils,
    ressources, étapes, documentation et mise en valeur. Ce sont les sources des fiches
    que vous voyez sur ce site.
  </p>

  <ul class="mt-10 grid gap-4 sm:grid-cols-2">
    {catalogues.map((c, i) => (
      <li
        class="reveal flex flex-col gap-3 rounded-xl border border-line bg-surface p-6 transition-colors duration-200 hover:border-ink-3/40"
        style={`--i:${i}`}
      >
        <div class="flex items-center gap-2 font-mono text-[11px] text-ink-3">
          <span class="h-1.5 w-1.5 rounded-xs" style={`background: ${c.color}`} aria-hidden="true" />
          catalogue {String(i + 1).padStart(2, '0')}
        </div>
        <h2 class="font-semibold tracking-tight">{c.title}</h2>
        <p class="text-sm leading-relaxed text-ink-2">{c.desc}</p>
        <div class="mt-auto flex gap-2 pt-2 text-sm">
          <a
            href={`/docs/${c.slug}.html`}
            class="rounded-md border border-line px-3 py-1.5 transition-colors duration-200 hover:border-ink-3"
          >
            Version interactive
          </a>
          <a
            href={`/docs/${c.slug}.pdf`}
            class="rounded-md border border-line px-3 py-1.5 font-mono text-[13px] transition-colors duration-200 hover:border-ink-3"
          >
            PDF ↓
          </a>
        </div>
      </li>
    ))}
  </ul>
</Base>
