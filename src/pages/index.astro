---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { DOMAINS, type Domain } from '../content.config';

const projets = await getCollection('projets');
const byDomain = (d: Domain) => projets.filter((p) => p.data.domain === d);
const count = (d: Domain, status?: string) =>
  byDomain(d).filter((p) => !status || p.data.status === status).length;

const recents = projets
  .filter((p) => p.data.status !== 'planifie')
  .sort((a, b) => (b.data.updated?.getTime() ?? 0) - (a.data.updated?.getTime() ?? 0))
  .slice(0, 6);
---

<Base title="Accueil">
  <section class="max-w-3xl">
    <h1 class="text-4xl font-bold tracking-tight">Kima Arnaud</h1>
    <p class="mt-4 text-lg text-slate-600">
      Ingénieur en formation continue : je réalise 80 projets complexes, documentés de la théorie à la mise en
      pratique, dans quatre domaines. Ce site est le point d'entrée ; chaque domaine possède sa plateforme
      avec les rapports, mesures, démos et code.
    </p>
  </section>

  <section class="mt-12" aria-labelledby="domaines">
    <h2 id="domaines" class="text-xl font-semibold">
      Quatre domaines, 80 projets
    </h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {(Object.keys(DOMAINS) as Domain[]).map((d) => (
        <a
          href={`/projets/?domain=${d}`}
          class="rounded-lg border border-slate-200 p-5 hover:border-slate-400 transition-colors"
        >
          <div class="text-sm text-slate-500">{DOMAINS[d].label}</div>
          <div class="mt-2 text-3xl font-bold">
            {count(d, 'termine')}
            <span class="text-slate-400 text-lg"> / {count(d)}</span>
          </div>
          <div class="mt-1 text-xs text-slate-500">terminés · {count(d, 'en-cours')} en cours</div>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-12" aria-labelledby="plateformes">
    <h2 id="plateformes" class="text-xl font-semibold">
      Les plateformes
    </h2>
    <ul class="mt-4 grid gap-4 sm:grid-cols-3">
      <li class="rounded-lg border border-slate-200 p-5">
        <a href="https://labhub.kimaarnaud.com" class="font-semibold hover:underline underline-offset-4">
          LabHub
        </a>
        <p class="text-sm text-slate-600 mt-1">
          Réseaux, systèmes et sécurité : topologies, configurations, rapports d'audit, tableaux de bord.
        </p>
      </li>
      <li class="rounded-lg border border-slate-200 p-5">
        <a href="https://telco.kimaarnaud.com" class="font-semibold hover:underline underline-offset-4">
          TelcoLab Hub
        </a>
        <p class="text-sm text-slate-600 mt-1">
          Télécoms : mesures radio, captures de protocoles, cartes de couverture, carnets rejouables.
        </p>
      </li>
      <li class="rounded-lg border border-slate-200 p-5">
        <a href="https://ai.kimaarnaud.com" class="font-semibold hover:underline underline-offset-4">
          AI Lab Hub
        </a>
        <p class="text-sm text-slate-600 mt-1">
          IA : expériences MLflow, fiches de modèles, démos, métriques de production.
        </p>
      </li>
    </ul>
  </section>

  {recents.length > 0 && (
    <section class="mt-12" aria-labelledby="recents">
      <h2 id="recents" class="text-xl font-semibold">
        Projets en cours ou terminés
      </h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {recents.map((p) => (
          <ProjectCard projet={p} />
        ))}
      </div>
    </section>
  )}
</Base>
