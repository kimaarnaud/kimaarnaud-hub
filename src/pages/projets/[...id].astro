---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { DOMAINS } from '../../content.config';

export async function getStaticPaths() {
  const projets = await getCollection('projets');
  return projets.map((p) => ({ params: { id: p.id }, props: { projet: p } }));
}

const { projet } = Astro.props;
const d = projet.data;
const domain = DOMAINS[d.domain];
const { Content } = await render(projet);
const num = String(d.number).padStart(2, '0');
const levelLabel = { fondations: 'Fondations', avance: 'Avancé', expert: 'Expert' }[d.level];

const links = [
  { key: 'demo', label: 'Démo en ligne', href: d.links.demo },
  {
    key: 'platform',
    label: 'Fiche complète sur la plateforme',
    href: d.links.platform ?? domain.platform ?? undefined,
  },
  { key: 'repo', label: 'Code source', href: d.links.repo },
  { key: 'report', label: 'Rapport (PDF)', href: d.links.report },
  { key: 'video', label: 'Vidéo de démonstration', href: d.links.video },
].filter((l) => l.href);

const meta = [
  { term: 'Domaine', value: domain.label },
  { term: 'Niveau', value: levelLabel },
  d.duration ? { term: 'Durée', value: d.duration } : null,
  d.updated
    ? { term: 'Mis à jour', value: d.updated.toLocaleDateString('fr-FR') }
    : null,
].filter(Boolean) as { term: string; value: string }[];
---

<Base title={d.title} description={d.summary}>
  <nav aria-label="Fil d'Ariane" class="flex items-center gap-2 font-mono text-xs text-ink-3">
    <a href="/projets/" class="transition-colors hover:text-ink">projets</a>
    <span aria-hidden="true">/</span>
    <a href={`/projets/?domain=${d.domain}`} class="transition-colors hover:text-ink">
      {d.domain}
    </a>
    <span aria-hidden="true">/</span>
    <span class="text-ink-2">{num}</span>
  </nav>

  <header
    class="mt-6 flex flex-wrap items-start justify-between gap-4 border-b border-line pb-8"
    style={`--dom: var(--${domain.color})`}
  >
    <div class="max-w-3xl">
      <p class="flex items-center gap-2 font-mono text-xs text-ink-3">
        <span class="h-2 w-2 rounded-[2px] bg-(--dom)" aria-hidden="true"></span>
        {domain.short} · fiche {num}
      </p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{d.title}</h1>
      <p class="mt-3 text-lg leading-relaxed text-ink-2">{d.summary}</p>
    </div>
    <StatusBadge status={d.status} />
  </header>

  {
    d.cover && (
      <div class="mt-8 overflow-hidden rounded-xl border border-line">
        {d.cover.format === 'svg' ? (
          <img
            src={d.cover.src}
            width={d.cover.width}
            height={d.cover.height}
            alt={`Couverture — ${d.title}`}
            class="aspect-[21/9] w-full object-cover"
          />
        ) : (
          <Image
            src={d.cover}
            alt={`Couverture — ${d.title}`}
            widths={[800, 1200]}
            sizes="(min-width: 1024px) 1152px, 100vw"
            class="aspect-[21/9] w-full object-cover"
          />
        )}
      </div>
    )
  }

  <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_280px]">
    <article class="prose max-w-none prose-code:before:content-none prose-code:after:content-none">
      <Content />
    </article>

    <aside class="space-y-8 text-sm lg:border-l lg:border-line lg:pl-8">
      <dl class="divide-y divide-line border-y border-line">
        {meta.map((m) => (
          <div class="flex items-baseline justify-between gap-4 py-2.5">
            <dt class="font-mono text-[11px] uppercase tracking-wider text-ink-3">{m.term}</dt>
            <dd class="text-right font-medium">{m.value}</dd>
          </div>
        ))}
      </dl>

      {d.stack.length > 0 && (
        <div>
          <h2 class="font-mono text-[11px] uppercase tracking-wider text-ink-3">Technologies</h2>
          <ul class="mt-2.5 flex flex-wrap gap-1">
            {d.stack.map((s) => (
              <li class="rounded bg-surface-2 px-2 py-0.5 font-mono text-[11px] text-ink-2">{s}</li>
            ))}
          </ul>
        </div>
      )}
      {d.skills.length > 0 && (
        <div>
          <h2 class="font-mono text-[11px] uppercase tracking-wider text-ink-3">Compétences</h2>
          <ul class="mt-2.5 list-disc space-y-0.5 pl-4 text-ink-2">
            {d.skills.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </div>
      )}
      {links.length > 0 && (
        <div>
          <h2 class="font-mono text-[11px] uppercase tracking-wider text-ink-3">Preuves</h2>
          <ul class="mt-2.5 space-y-1.5">
            {links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="text-accent-ink underline underline-offset-4 transition-colors hover:text-accent"
                >
                  {l.label} ↗
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>
</Base>
