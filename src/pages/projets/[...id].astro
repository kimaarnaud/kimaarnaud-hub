---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { DOMAINS } from '../../content.config';

export async function getStaticPaths() {
  const projets = await getCollection('projets');
  return projets.map((p) => ({ params: { id: p.id }, props: { projet: p } }));
}

const { projet } = Astro.props;
const d = projet.data;
const domain = DOMAINS[d.domain];
const { Content } = await render(projet);
const num = String(d.number).padStart(2, '0');
const levelLabel = { fondations: 'Fondations', avance: 'Avancé', expert: 'Expert' }[d.level];

const links = [
  { key: 'demo', label: 'Démo en ligne', href: d.links.demo },
  {
    key: 'platform',
    label: 'Fiche complète sur la plateforme',
    href: d.links.platform ?? domain.platform ?? undefined,
  },
  { key: 'repo', label: 'Code source', href: d.links.repo },
  { key: 'report', label: 'Rapport (PDF)', href: d.links.report },
  { key: 'video', label: 'Vidéo de démonstration', href: d.links.video },
].filter((l) => l.href);
---

<Base title={d.title} description={d.summary}>
  <nav aria-label="Fil d'Ariane" class="text-sm text-slate-500">
    <a href="/projets/" class="hover:underline">
      Projets
    </a>{' '}
    ›
    <a href={`/projets/?domain=${d.domain}`} class="hover:underline">
      {domain.short}
    </a>{' '}
    › {num}
  </nav>

  <header class="mt-4 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">
        {num} · {d.title}
      </h1>
      <p class="mt-2 text-lg text-slate-600 max-w-3xl">{d.summary}</p>
    </div>
    <StatusBadge status={d.status} />
  </header>

  <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_280px]">
    <article class="prose prose-slate max-w-none prose-code:before:content-none prose-code:after:content-none">
      <Content />
    </article>

    <aside class="space-y-6 text-sm">
      <dl class="space-y-3">
        <div>
          <dt class="text-slate-500">Domaine</dt>
          <dd class="font-medium">{domain.label}</dd>
        </div>
        <div>
          <dt class="text-slate-500">Niveau</dt>
          <dd class="font-medium">{levelLabel}</dd>
        </div>
        {d.duration && (
          <div>
            <dt class="text-slate-500">Durée</dt>
            <dd class="font-medium">{d.duration}</dd>
          </div>
        )}
        {d.updated && (
          <div>
            <dt class="text-slate-500">Mis à jour</dt>
            <dd class="font-medium">{d.updated.toLocaleDateString('fr-FR')}</dd>
          </div>
        )}
      </dl>

      {d.stack.length > 0 && (
        <div>
          <h2 class="text-slate-500">Technologies</h2>
          <ul class="mt-1 flex flex-wrap gap-1">
            {d.stack.map((s) => (
              <li class="rounded bg-slate-100 px-2 py-0.5 text-xs">{s}</li>
            ))}
          </ul>
        </div>
      )}
      {d.skills.length > 0 && (
        <div>
          <h2 class="text-slate-500">Compétences</h2>
          <ul class="mt-1 list-disc pl-4 space-y-0.5">
            {d.skills.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </div>
      )}
      {links.length > 0 && (
        <div>
          <h2 class="text-slate-500">Preuves de réalisation</h2>
          <ul class="mt-1 space-y-1">
            {links.map((l) => (
              <li>
                <a href={l.href} class="underline underline-offset-4 hover:text-slate-600">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>
</Base>
