---
import Base from '../../layouts/Base.astro';

const catalogues = [
  {
    slug: '20-projets-logiciels',
    title: '20 software development projects',
    desc: 'Web and mobile applications, justified stacks, features, phases and documentation.',
    color: 'var(--dom-logiciel)',
  },
  {
    slug: '20-projets-reseaux-systemes-securite',
    title: '20 network, systems & security projects',
    desc: 'From virtual lab to SOC: concepts, tools, steps, proof and the LabHub platform.',
    color: 'var(--dom-reseaux)',
  },
  {
    slug: '20-projets-telecoms',
    title: '20 telecom projects',
    desc: 'Signal, IP/MPLS, VoIP, FTTH, 4G/5G, LoRaWAN, satellite, NFV: measurements and TelcoLab Hub.',
    color: 'var(--dom-telecoms)',
  },
  {
    slug: '20-projets-ia',
    title: '20 artificial intelligence projects',
    desc: 'From hand-written ML to governed AI products: experiments, evaluation, MLOps and AI Lab Hub.',
    color: 'var(--dom-ia)',
  },
];
---

<Base
  title="Catalogs"
  lang="en"
  description="The four project catalogs structuring this portfolio, readable online or as PDF (in French)."
>
  <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent-ink">Roadmaps</p>
  <h1 class="mt-3 text-4xl font-bold tracking-tight">Project catalogs</h1>
  <p class="mt-3 max-w-[62ch] text-ink-2">
    Each catalog describes 20 progressive projects: goal, concepts to learn, tools,
    resources, steps, documentation and showcasing. They are the sources behind every
    file on this site — currently written in French.
  </p>

  <ul class="mt-10 grid gap-4 sm:grid-cols-2">
    {catalogues.map((c, i) => (
      <li
        class="reveal flex flex-col gap-3 rounded-xl border border-line bg-surface p-6 transition-colors duration-200 hover:border-ink-3/40"
        style={`--i:${i}`}
      >
        <div class="flex items-center gap-2 font-mono text-[11px] text-ink-3">
          <span class="h-1.5 w-1.5 rounded-xs" style={`background: ${c.color}`} aria-hidden="true" />
          catalog {String(i + 1).padStart(2, '0')}
        </div>
        <h2 class="font-semibold tracking-tight">{c.title}</h2>
        <p class="text-sm leading-relaxed text-ink-2">{c.desc}</p>
        <div class="mt-auto flex gap-2 pt-2 text-sm">
          <a
            href={`/docs/${c.slug}.html`}
            class="rounded-md border border-line px-3 py-1.5 transition-colors duration-200 hover:border-ink-3"
            hreflang="fr"
          >
            Interactive version (fr)
          </a>
          <a
            href={`/docs/${c.slug}.pdf`}
            class="rounded-md border border-line px-3 py-1.5 font-mono text-[13px] transition-colors duration-200 hover:border-ink-3"
          >
            PDF ↓
          </a>
        </div>
      </li>
    ))}
  </ul>
</Base>
