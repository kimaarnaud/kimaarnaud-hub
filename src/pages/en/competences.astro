---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { DOMAINS, domainLabel } from '../../content.config';

const projets = await getCollection('projets');

const skills = new Map<string, typeof projets>();
for (const p of projets) {
  for (const s of p.data.skills) {
    if (!skills.has(s)) skills.set(s, []);
    skills.get(s)!.push(p);
  }
}
const rows = [...skills.entries()].sort(
  (a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0], 'en'),
);
---

<Base title="Skills" lang="en" description="Matrix of demonstrated skills and the projects that prove them.">
  <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent-ink">Generated matrix</p>
  <h1 class="mt-3 text-4xl font-bold tracking-tight">Skills</h1>
  <p class="mt-3 max-w-[62ch] text-ink-2">
    Every skill is linked to the projects that demonstrate it. This matrix is generated
    automatically from the project files: it cannot lie. Skill names come from the
    French files.
  </p>

  <div class="mt-10 overflow-x-auto">
    <table class="w-full border-collapse text-sm">
      <caption class="sr-only">Skills and associated projects</caption>
      <thead>
        <tr class="border-b border-line text-left">
          <th scope="col" class="py-2.5 pr-4 font-mono text-[11px] font-normal uppercase tracking-wider text-ink-3">
            Skill
          </th>
          <th scope="col" class="py-2.5 pr-4 text-right font-mono text-[11px] font-normal uppercase tracking-wider text-ink-3">
            Projects
          </th>
          <th scope="col" class="py-2.5 font-mono text-[11px] font-normal uppercase tracking-wider text-ink-3">
            Demonstrated by
          </th>
        </tr>
      </thead>
      <tbody>
        {rows.map(([skill, list]) => (
          <tr class="border-b border-line/60 align-top transition-colors hover:bg-surface">
            <th scope="row" class="py-3 pr-4 font-medium">
              {skill}
            </th>
            <td class="py-3 pr-4 text-right font-mono text-xs tabular-nums text-ink-2">{list.length}</td>
            <td class="py-3">
              <ul class="flex flex-wrap gap-x-4 gap-y-1.5">
                {list.map((p) => (
                  <li>
                    <a
                      href={`/fr/projets/${p.id}/`}
                      hreflang="fr"
                      class="inline-flex items-center gap-1.5 font-mono text-xs text-ink-2 underline-offset-4 transition-colors hover:text-ink hover:underline"
                    >
                      <span
                        class="h-1.5 w-1.5 rounded-xs"
                        style={`background: var(--${DOMAINS[p.data.domain].color})`}
                        aria-hidden="true"
                      />
                      {domainLabel(p.data.domain, 'en').short} {String(p.data.number).padStart(2, '0')}
                    </a>
                    {p.data.status === 'termine' && (
                      <span class="text-emerald-600 dark:text-emerald-400" aria-label="completed" title="completed">
                        {' '}●
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {rows.length === 0 && (
    <p class="mt-6 text-ink-2">
      No skills listed yet: add <code>skills</code> to the project files.
    </p>
  )}
</Base>
