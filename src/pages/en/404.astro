---
import Base from '../../layouts/Base.astro';
---

<Base title="Page not found" lang="en">
  <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent-ink">error 404</p>
  <h1 class="mt-3 text-4xl font-bold tracking-tight">Page not found</h1>
  <p class="mt-3 max-w-[62ch] text-ink-2">
    This page does not exist or has been moved.
  </p>
  <a
    href="/en/"
    class="mt-8 inline-flex items-center rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-bg transition-transform duration-150 ease-(--ease-out-expo) hover:opacity-90 active:scale-[0.98]"
  >
    ← Back to home
  </a>
</Base>
