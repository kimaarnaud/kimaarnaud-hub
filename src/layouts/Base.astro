---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Portfolio technique de Kima Arnaud : projets en développement logiciel, réseaux, systèmes, sécurité, télécoms et intelligence artificielle.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { href: '/projets/', label: 'Projets' },
  { href: '/catalogues/', label: 'Catalogues' },
  { href: '/competences/', label: 'Compétences' },
  { href: '/contact/', label: 'Contact' },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="fr" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{title} · kimaarnaud.com</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body class="min-h-full flex flex-col bg-white text-slate-900 antialiased">
    <header class="border-b border-slate-200">
      <div class="mx-auto max-w-6xl px-4 py-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
        <a href="/" class="font-semibold tracking-tight text-lg">
          kimaarnaud<span class="text-slate-400">.com</span>
        </a>
        <nav aria-label="Navigation principale" class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={current.startsWith(item.href) ? 'page' : undefined}
              class="hover:text-slate-600 aria-[current=page]:font-semibold aria-[current=page]:underline underline-offset-4"
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class="flex-1 mx-auto w-full max-w-6xl px-4 py-10">
      <slot />
    </main>

    <footer class="border-t border-slate-200 text-sm text-slate-500">
      <div class="mx-auto max-w-6xl px-4 py-6 flex flex-wrap gap-x-6 gap-y-2 justify-between">
        <span>© {new Date().getFullYear()} Kima Arnaud</span>
        <span class="flex gap-4">
          <a href="https://labhub.kimaarnaud.com" class="hover:text-slate-800">
            LabHub
          </a>
          <a href="https://telco.kimaarnaud.com" class="hover:text-slate-800">
            TelcoLab Hub
          </a>
          <a href="https://ai.kimaarnaud.com" class="hover:text-slate-800">
            AI Lab Hub
          </a>
          <a href="https://status.kimaarnaud.com" class="hover:text-slate-800">
            Statut
          </a>
          <a href="/mentions-legales/" class="hover:text-slate-800">
            Mentions légales
          </a>
        </span>
      </div>
    </footer>
  </body>
</html>
