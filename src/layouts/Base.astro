---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import {
  type Lang,
  getLangFromUrl,
  useTranslations,
  localizeHref,
  equivalentPath,
} from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: Lang;
  /** false pour les pages qui n'ont pas d'équivalent dans l'autre langue (fiches FR, journal FR) */
  hasAlternate?: boolean;
}

const {
  title,
  description = 'Portfolio technique de Kima Arnaud : projets en développement logiciel, réseaux, systèmes, sécurité, télécoms et intelligence artificielle.',
  ogImage = '/og.png',
  lang = getLangFromUrl(Astro.url),
  hasAlternate = true,
} = Astro.props;

const t = useTranslations(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
const otherLang: Lang = lang === 'fr' ? 'en' : 'fr';
const alternatePath = equivalentPath(Astro.url.pathname, lang);

const nav = [
  { href: '/projets/', label: t('nav.projets'), localized: true },
  { href: '/catalogues/', label: t('nav.catalogues'), localized: true },
  { href: '/competences/', label: t('nav.competences'), localized: true },
  { href: '/cv/', label: t('nav.cv'), localized: true },
  { href: '/fr/blog/', label: t('nav.journal'), localized: false },
  { href: '/contact/', label: t('nav.contact'), localized: true },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang={lang} class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {
      hasAlternate && (
        <>
          <link rel="alternate" hreflang={lang} href={canonical} />
          <link rel="alternate" hreflang={otherLang} href={new URL(alternatePath, Astro.site)} />
          <link rel="alternate" hreflang="x-default" href={new URL(equivalentPath(Astro.url.pathname, 'en'), Astro.site)} />
        </>
      )
    }
    <title>{title} · kimaarnaud.com</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:site_name" content="kimaarnaud.com" />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogUrl} />
    <link rel="alternate" type="application/rss+xml" title="Journal — kimaarnaud.com" href="/rss.xml" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const dark = stored
          ? stored === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="flex min-h-full flex-col bg-bg font-sans text-ink antialiased">
    <header
      class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md"
    >
      <div
        class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3.5"
      >
        <a
          href={localizeHref('/', lang)}
          class="group flex items-center gap-2.5 font-semibold tracking-tight"
        >
          <svg
            class="h-5 w-5 text-ink transition-transform duration-200 ease-(--ease-out-expo) group-hover:rotate-90"
            viewBox="0 0 20 20"
            fill="none"
            aria-hidden="true"
          >
            <rect x="1" y="1" width="18" height="18" rx="4" stroke="currentColor" stroke-width="1.5" />
            <rect x="5.5" y="5.5" width="3" height="3" rx="0.75" fill="currentColor" />
            <rect x="11.5" y="5.5" width="3" height="3" rx="0.75" fill="currentColor" />
            <rect x="5.5" y="11.5" width="3" height="3" rx="0.75" fill="currentColor" />
            <rect x="11.5" y="11.5" width="3" height="3" rx="0.75" class="fill-accent" />
          </svg>
          <span>
            kimaarnaud<span class="text-ink-3">.com</span>
          </span>
        </a>
        <div class="flex items-center gap-x-4 sm:gap-x-5">
          <nav aria-label="Navigation principale" class="flex flex-wrap gap-x-4 gap-y-1 text-sm sm:gap-x-5">
            {
              nav.map((item) => {
                const href = item.localized ? localizeHref(item.href, lang) : item.href;
                const active = current.startsWith(href);
                return (
                  <a
                    href={href}
                    aria-current={active ? 'page' : undefined}
                    hreflang={item.localized ? lang : 'fr'}
                    class="text-ink-2 transition-colors duration-200 hover:text-ink aria-[current=page]:font-medium aria-[current=page]:text-ink aria-[current=page]:underline underline-offset-[5px] decoration-accent decoration-2"
                  >
                    {item.label}
                  </a>
                );
              })
            }
          </nav>
          <a
            href={hasAlternate ? alternatePath : localizeHref('/', otherLang)}
            hreflang={otherLang}
            class="rounded border border-line px-2 py-1 font-mono text-[11px] text-ink-3 transition-colors duration-200 hover:border-ink-3 hover:text-ink"
            aria-label={lang === 'fr' ? 'English version' : 'Version française'}
          >
            {otherLang.toUpperCase()}
          </a>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-12 sm:py-16">
      <slot />
    </main>

    <footer class="border-t border-line text-sm text-ink-3">
      <div
        class="mx-auto flex max-w-6xl flex-wrap justify-between gap-x-6 gap-y-2 px-4 py-6"
      >
        <span class="font-mono text-xs">
          © {new Date().getFullYear()} Kima Yves Arnaud — {t('footer.note')}
        </span>
        <span class="flex gap-4">
          <a href="https://labhub.kimaarnaud.com" class="transition-colors duration-200 hover:text-ink">LabHub</a>
          <a href="https://telco.kimaarnaud.com" class="transition-colors duration-200 hover:text-ink">TelcoLab</a>
          <a href="https://ai.kimaarnaud.com" class="transition-colors duration-200 hover:text-ink">AI Lab</a>
          <a href="https://status.kimaarnaud.com" class="transition-colors duration-200 hover:text-ink">{t('footer.status')}</a>
          <a href={localizeHref('/mentions-legales/', lang)} class="transition-colors duration-200 hover:text-ink">{t('footer.legal')}</a>
        </span>
      </div>
    </footer>

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
